        <path
            android:pathData="M 480,580 L 520,577 L 640,577 L 640,583 L 520,583 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M 650,570 A 10,10 0 1,1 650,590 A 10,10 0 1,1 650,570"
            android:strokeWidth="6">
            <aapt:attr name="android:strokeColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M 470,610 L 572,607 L 587,622 L 603,622 L 603,628 L 593,628 L 578,613 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M 610,618 A 7,7 0 1,1 610,632 A 7,7 0 1,1 610,618"
            android:strokeWidth="5">
            <aapt:attr name="android:strokeColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>
