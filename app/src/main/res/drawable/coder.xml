                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Center Flare (Semi-transparent vector fallback for blur effect) -->
        <path
            android:pathData="M 260,375 A 25,45 0 1,1 260,465 A 25,45 0 1,1 260,375"
            android:fillColor="#9900FFFF" />

        <!-- Left Vertical Element: {} -->
        <path
            android:pathData="M 255,380 Q 245,380 245,395 T 235,420 Q 245,420 245,445 T 255,460 M 265,380 Q 275,380 275,395 T 285,420 Q 275,420 275,445 T 265,460"
            android:strokeWidth="10"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Bottom Arm Element: - (Dash/Rect) -->
        <path
            android:pathData="M 397,596 L 433,596 A 2,2 0 0,1 435,598 L 435,602 A 2,2 0 0,1 433,604 L 397,604 A 2,2 0 0,1 395,602 L 395,598 A 2,2 0 0,1 397,596 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Top-Left Circuit Nodes & Lines -->
        <path
            android:pathData="M 160,252 A 8,8 0 1,1 160,268 A 8,8 0 1,1 160,252"
            android:strokeWidth="6">
            <aapt:attr name="android:strokeColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
