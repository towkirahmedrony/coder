<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1080"
    android:viewportHeight="1080">

    <!-- লোগোটিকে মাঝখানে আনার জন্য একটি Group ব্যবহার করা হয়েছে এবং একটু স্কেল ডাউন করে ডানে-নিচে সরানো হয়েছে -->
    <group
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="235"
        android:translateY="235">

        <!-- Main 'C' Geometric Frame -->
        <path
            android:pathData="M 620,200 L 320,200 L 220,300 L 220,540 L 320,640 L 580,640 L 520,560 L 320,560 L 300,540 L 300,300 L 320,280 L 560,280 Z"
            android:strokeWidth="10"
            android:strokeLineJoin="miter">
            <aapt:attr name="android:strokeColor">
                <gradient android:startX="150" android:startY="200" android:endX="650" android:endY="650" android:type="linear">
                    <item android:offset="0.0" android:color="#00FFFF"/>
                    <item android:offset="1.0" android:color="#39FF14"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Top Arm Element: </> -->
        <path
            android:pathData="M 405,225 L 385,240 L 405,255 M 435,265 L 455,215 M 485,225 L 505,240 L 485,255"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
